# Copy settings into your shell or a private local launcher; this file is documentation only.
# Default: 127.0.0.1:4765. Never forward this port directly to the public internet.
PORT=4765
HOST=127.0.0.1
# Optional: allow only specific local project directories, separated by your OS path delimiter.
# Windows example: CODEX_WORKSPACES=C:\\projects\\one;C:\\projects\\two
# macOS/Linux example: CODEX_WORKSPACES=/home/me/project-one:/home/me/project-two
# CODEX_WORKSPACES=
# Optional 32+ character secret; otherwise one is created in .local/access-token.
# REMOTE_WEB_ACCESS_TOKEN=
# To use a trusted HTTPS tailnet reverse proxy, configure its hostname here.
# TRUSTED_HOSTS=my-pc.my-tailnet.ts.net
